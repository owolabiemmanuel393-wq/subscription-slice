# ---------------------------------------------------------------------------
# GymLog Environment Variables Example
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
#
# DO NOT commit .env with real credentials to version control.
# ---------------------------------------------------------------------------

# Database connection URL for PostgreSQL
# Format: postgresql://<USERNAME>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
# Example for local PostgreSQL:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gymlog_dev?schema=public"
DATABASE_URL=""

# Secret string used for generating and signing secure session tokens and hashes
# You can generate a strong secret with: openssl rand -base64 32
SESSION_SECRET=""

# Base application URL used for generating absolute links (e.g. password reset link in emails)
# In development, this is typically http://localhost:3000
APP_URL="http://localhost:3000"

# Application runtime environment: "development" | "test" | "production"
NODE_ENV="development"

# Email Configuration
# EMAIL_PROVIDER options:
#   "console"    -> (Default) Prints email to terminal
#   "nodemailer" -> Sends real emails via SMTP (e.g. Gmail App Password)
#   "ethereal"   -> Fake throwaway inbox with click-to-view preview link in terminal
#   "resend"     -> Sends via Resend API
EMAIL_PROVIDER="console"

# Nodemailer / SMTP Configuration (for Gmail, Outlook, or custom SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
# For Gmail: generate a 16-character App Password at https://myaccount.google.com/apppasswords
SMTP_PASS=""
EMAIL_FROM=""

# Resend API Key (only if EMAIL_PROVIDER="resend")
RESEND_API_KEY=""
